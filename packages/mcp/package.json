{
  "name": "solo-issue-mcp",
  "version": "0.0.2",
  "description": "MCP server for solo-issue: a thin protocol adapter over its REST API, driven by Bearer tokens issued from the deployment.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xesam/solo-issue.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "solo-issue",
    "issue-tracker",
    "mcp",
    "model-context-protocol",
    "mcp-server"
  ],
  "bin": {
    "solo-issue-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsdown": "^0.23.1",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
