{
  "name": "solo-issue",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "node -r dotenv/config \"$PWD/node_modules/next/dist/bin/next\" dev",
    "dev:up": "bash scripts/dev-up.sh",
    "dev:restart": "bash scripts/dev-restart.sh",
    "dev:stop": "bash scripts/dev-stop.sh",
    "build": "prisma generate && next build",
    "start": "node -r dotenv/config \"$PWD/node_modules/next/dist/bin/next\" start",
    "worker": "tsx src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "add-user": "tsx scripts/ops-add-user.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "verify:seed": "tsx scripts/verify-seed.ts",
    "verify": "bash scripts/verify-all.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@prisma/client": "^6",
    "@tanstack/react-query": "^5.102.8",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-mention": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@tiptap/suggestion": "^2.27.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^16",
    "lucide-react": "^1.42.0",
    "next": "^15",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "pg-boss": "^10",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "prisma": "^6",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
