# ══ 基础 ══

# ── DATABASE_URL ──
DATABASE_URL=postgres://postgres:postgres@localhost:5432/solo_issue

# ── PORT ──
# 服务端口：pnpm dev / pnpm start 均读取（启动时经 dotenv 注入；验收脚本同源）
PORT=8081

# ── BASE_PATH ──
# 部署子路径（⚠️ 构建期配置：改值须重新 pnpm build / docker compose --build 后生效，
# 构建与运行须保持同值）。默认 /solo-issue；设 / 为根路径部署（域名根，无任何前缀）；
# 可自定义任意前缀（如 /issues，无需前导斜杠）。
# Docker Compose 部署跟随启服命令的 env 来源——README 标准命令用 --env-file 指向本文件；
# compose 只读其插值来源的 env 文件（apps/web/.env 不写值时 compose 读仓库根 .env），
# 且 .env 不进镜像上下文，本文件的 BASE_PATH 对纯 docker compose up 不生效。
# BASE_PATH=/solo-issue

# ── APP_URL ──
# 站点绝对地址（IM 推送深链、企微 OAuth 回调都以它为拼基）。
# ⚠️ 必须包含部署 basePath（与上面 BASE_PATH 一致）：本机即 http://localhost:8081/solo-issue；
# 线上填 https://<网关>/solo-issue（漏掉前缀会让 IM 深链与企微回调全部 404）。
# 根路径部署（BASE_PATH=/）务必显式设置 APP_URL 为不带尾斜杠的根地址（如 http://host:8081）——
# compose 的默认插值带尾斜杠，IM 深链会出现 // 双斜杠
APP_URL=http://localhost:8081/solo-issue

# ══ 种子参数（幂等：仅在尚无管理员时建号；已有数据不覆盖）══

# ── ADMIN_EMAIL ──
# 管理员登录键：不设则用占位 solo-issue@github.com（仓库公开常量，生产建议必改；
# 存量账号可随时在管理台「用户 → 编辑」修改邮箱）
# ADMIN_EMAIL=admin@yourcompany.com

# ── ADMIN_INIT_PASSWORD ──
# 初始密码（首登强制改密）
# ADMIN_INIT_PASSWORD=change-me-on-first-login

# ══ 附件存储（默认值即可，生产建议挂独立卷）══

# ── UPLOAD_DIR ──
# UPLOAD_DIR=uploads

# ── MAX_UPLOAD_MB ──
# MAX_UPLOAD_MB=10

# ══ 开发开关 ══

# ── ALLOW_DEV_LOGIN ──
# ALLOW_DEV_LOGIN=true

# ── ALLOW_IM_MOCK ──
# ALLOW_IM_MOCK=true

# ── ALLOW_INSECURE_COOKIES ──
# 纯 HTTP 内网部署（无 TLS，如 http://192.168.x.x:8081 直连）时置 1：
# 放行非 Secure 会话 cookie，否则浏览器拒绝携带 cookie 导致登录后仍 401 循环。
# 走 HTTPS 反代（nginx + 证书）的正式部署保持默认空。
# ALLOW_INSECURE_COOKIES=1

# ══ 限流取 IP 的方式（见 docs/08-deployment.md 环境变量全表）══

# ── TRUST_PROXY ──
# 有反向代理置前保持默认（采信 X-Forwarded-For / X-Real-IP）；
# 直暴端口、前面没有反向代理时设 0（不采信，防伪造头绕过限流）——
# 代价：全部匿名请求共享同一个 IP 桶（如 10 次/分的登录限流全站共用额度）。
# TRUST_PROXY=

# ══ Docker Compose 部署（可选）══

# ── APP_PORT ──
# APP_PORT=8081

# ── POSTGRES_TAG ──
# 本地 OrbStack 等新内核用 16；老内核服务器（5.7 内核 + 旧版 docker）实测 16 initdb
# 报 Operation not permitted，须用默认 15。注意：与既有 pgdata 卷的数据大版本必须一致
# POSTGRES_TAG=16-alpine

# ══ Docker 构建镜像加速（国内用户取消注释）══

# Docker 镜像构建默认使用官方源（国外用户最快）；
# 国内用户取消下面三行注释可大幅加速 pnpm install 和 apt 包下载
# ── DEBIAN_MIRROR ──
# DEBIAN_MIRROR=mirrors.huaweicloud.com

# ── NPM_REGISTRY ──
# NPM_REGISTRY=https://registry.npmmirror.com

# ── PRISMA_MIRROR ──
# PRISMA_MIRROR=https://registry.npmmirror.com/-/binary/prisma

# ══ 企业微信登录/通知 ══

# ── WECOM_CORP_ID / WECOM_AGENT_ID / WECOM_SECRET ──
# 三种状态自动识别：
#   1) 三个 WECOM_* 都填 → 真实适配器（公司正式应用）
#   2) 未填凭证且 ALLOW_IM_MOCK=true → 模拟通道（开发/联调用，凭证到位后自动切换）
#   3) 都未配置 → 登录页不显示企微入口
# 申请与配置步骤见 docs/09-wecom-setup.md「接入企业微信」
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_SECRET=
